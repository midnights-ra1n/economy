# Economy settings. Kept across upgrades. Apply changes with: sudo systemctl restart economy

# Public URL of the app, without trailing slash. Passkeys only work on this exact origin (https outside localhost).
ORIGIN=http://localhost:3000

# PORT=3000
# Listen on localhost only, behind a reverse proxy on the same machine:
# HOSTNAME=127.0.0.1
# Time zone of the monthly due dates (default: the system's).
# TZ=Europe/Paris
# UPDATE_CHECK=false
# SETUP_WINDOW_MINUTES=10
