#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
if [ "$1" = purge ]; then
  # The database is never deleted by the package: removing your budget takes an explicit rm.
  echo "Economy's data is kept in /var/lib/economy (and the economy user). Delete it yourself if you no longer need it."
fi
